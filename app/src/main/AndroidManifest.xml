<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Phase 3's reminders, and nothing more. Still no INTERNET permission: that is Phase 4.

      USE_EXACT_ALARM (API 33+) is granted at install and cannot be revoked, so there is no Settings
      trip and no refusal path to handle. Google restricts it to alarm clocks and calendars for apps
      on the Play Store; this one is installed straight from Android Studio and never goes there.
      SCHEDULE_EXACT_ALARM covers Android 12 and 12L, where USE_EXACT_ALARM does not exist yet and
      this one is granted automatically; below API 31 an exact alarm needs no permission at all.
      Olda chose this route on 28 Nov.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:name=".TasksApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tasks">
        <!-- singleTop: tapping a reminder reuses the running app instead of stacking a second copy. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Tasks"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Where the exact alarm lands. Not exported: only this app's own alarm starts it. -->
        <receiver
            android:name=".platform.ReminderReceiver"
            android:exported="false" />

        <!-- Done and Snooze. Not exported: only this app's own notifications start it. -->
        <receiver
            android:name=".platform.ReminderActionReceiver"
            android:exported="false" />

        <!--
          Puts the booked alarm back. A restart cancels it; a time-zone or clock change leaves it
          on the wrong local hour; and MY_PACKAGE_REPLACED is the one that matters most while this
          app is being built, since every installDebug cancels its alarms. Exported, because these
          four come from the system.
        -->
        <receiver
            android:name=".platform.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>