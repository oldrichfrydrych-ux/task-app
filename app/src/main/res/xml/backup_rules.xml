<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and older (API 30-).
    The task database is excluded on purpose: a live SQLite file copied while its
    write-ahead log is unmerged is not a safe backup and could restore as a corrupt
    or stale database. Real backup and restore is Phase 6.
-->
<full-backup-content>
    <exclude domain="database" path="tasks.db" />
    <exclude domain="database" path="tasks.db-wal" />
    <exclude domain="database" path="tasks.db-shm" />
    <exclude domain="database" path="tasks.db-journal" />
</full-backup-content>
